    });
    refreshGroups(panel);
  }
  var fbtns = Array.prototype.slice.call(document.querySelectorAll('.fbtn[data-filter]'));
  fbtns.forEach(function(b){
    b.addEventListener('click', function(){
      var scope = b.getAttribute('data-scope');
      Array.prototype.slice.call(document.querySelectorAll('.fbtn[data-filter][data-scope="'+scope+'"]')).forEach(function(x){
        x.classList.toggle('active', x === b);
      });
      applyFilter(scope, b.getAttribute('data-filter'));
    });
  });

  // ---------- 卡片展开 / 收起 ----------
  function setCard(card, open){
    card.classList.toggle('open', open);
    var t = card.querySelector('.toggle');
    if(t){ t.textContent = open ? '收起内容 ▴' : '展开全文 ▾'; }
  }
  var cards = Array.prototype.slice.call(document.querySelectorAll('.card'));
  cards.forEach(function(card){
    card.style.cursor = 'pointer';
    card.addEventListener('click', function(e){
      if(e.target.closest('a')) return;           // 点击链接正常跳转，不触发展开
      var tg = card.querySelector('.toggle');
      if(e.target === tg || e.target === tg.firstChild){
        setCard(card, !card.classList.contains('open'));
        return;
      }
      if(!card.classList.contains('open')) setCard(card, true);   // 折叠时点卡片任意处展开
    });
  });

  // ---------- 全部展开 / 收起 ----------
  Array.prototype.slice.call(document.querySelectorAll('[data-expand-all]')).forEach(function(b){
    b.addEventListener('click', function(e){
      e.stopPropagation();
      var scope  = b.getAttribute('data-expand-all');
      var list   = Array.prototype.slice.call(document.querySelectorAll('#p-' + scope + ' .card'));
      var expand = b.getAttribute('data-state') !== 'on';
      list.forEach(function(c){ setCard(c, expand); });
      b.setAttribute('data-state', expand ? 'on' : 'off');
      b.textContent = expand ? '收起全部卡片' : '展开全部卡片';
    });
  });

  panels.forEach(refreshGroups);
})();
</script>

</body>
</html>
